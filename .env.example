# Neo4j Database Connection
# If using local Neo4j (Docker/Desktop):
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=campuspassword123
NEO4J_DATABASE=neo4j

# If using Neo4j AuraDB (Cloud):
# NEO4J_URI=neo4j+s://<your-aura-instance-id>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<your-aura-password>
# NEO4J_DATABASE=neo4j

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=campus_event_super_secret_jwt_key_2026_xyz
JWT_EXPIRES_IN=7d
